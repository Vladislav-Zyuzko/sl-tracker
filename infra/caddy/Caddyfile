# Боевой обратный прокси SL Tracker.
# Фронт и API на одном домене — docs/adr/0001-single-domain-first-party-session.md
#
# Переменные приходят из окружения контейнера (см. docker-compose.prod.yml):
#   SL_DOMAIN      — адрес приложения, например tracker.185-12-34-56.sslip.io
#   SL_S3_DOMAIN   — адрес хранилища,  например s3.185-12-34-56.sslip.io
#   SL_ACME_EMAIL  — почта для Let's Encrypt
{
	email {$SL_ACME_EMAIL}

	# Порты. На этом сервере TCP 443 занят XRay от Amnezia (маскировка VPN
	# под HTTPS), поэтому приложение отдаётся на 8443, а 80-й остаётся
	# за Caddy — он нужен Let's Encrypt для проверки домена и для
	# перенаправления на HTTPS. Отобрать 443 у XRay нельзя: сломается VPN.
	http_port {$SL_HTTP_PORT:80}
	https_port {$SL_HTTPS_PORT:443}

	# HTTP/3 выключен намеренно. Он слушает UDP, а на этом сервере рядом живёт
	# VPN на основе WireGuard. Конфликт по UDP не виден при проверке TCP
	# и проявился бы падением либо прокси, либо VPN. Цена отказа — чуть
	# медленнее установка соединения на плохих сетях; HTTP/2 работает как прежде.
	servers {
		protocols h1 h2
	}
}

# --- HTTP → HTTPS ---------------------------------------------------------
# Явный редирект вместо автоматического. Автоматический не дописывает порт,
# когда задан https_port: считается, что снаружи это 443. У нас снаружи 8443,
# а на 443 сидит XRay — человек, набравший адрес без https, попадал на VPN
# и видел ошибку сертификата. Проверки Let's Encrypt (/.well-known/acme-challenge/)
# Caddy перехватывает до этого блока, продление сертификатов он не ломает.
# 308, как у автоматического: сохраняет метод запроса.
http://{$SL_DOMAIN}, http://{$SL_S3_DOMAIN} {
	redir https://{host}:{$SL_HTTPS_PORT:443}{uri} 308
}

# --- Приложение -----------------------------------------------------------
{$SL_DOMAIN} {
	encode zstd gzip

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
		}
		format json
	}

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API и WebSocket. Upgrade Caddy пропускает сам, отдельной директивы
	# не нужно — проверено на локальном стенде: рукопожатие /api/ws
	# доходит до NestJS и без сессии отбивается 401.
	handle /api/* {
		reverse_proxy api:3000 {
			health_uri /api/health
			health_interval 10s
		}
	}

	# --- Статика Flutter ---
	handle {
		root * /srv/web

		# index.html и service worker не кэшируем: иначе после выката
		# пользователь останется на старой сборке.
		@nocache path /index.html /flutter_service_worker.js /version.json
		header @nocache Cache-Control "no-cache, no-store, must-revalidate"

		# Path-роутинг: любой неизвестный путь отдаём приложению,
		# иначе F5 на /issues/DEV-42 вернёт 404 (ADR-0005).
		try_files {path} /index.html
		file_server
	}
}

# --- Хранилище вложений ---------------------------------------------------
# Отдельным именем, а не путём внутри основного домена: подпись S3 считается
# от хоста и пути, и префикс вида /s3 ломает проверку подписи на стороне MinIO.
# Сюда ходит только браузер по заранее подписанным ссылкам со сроком 10 минут;
# без подписи MinIO отвечает 403 сам.
{$SL_S3_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Консоль MinIO наружу не отдаём: она админская и ей в интернете нечего делать.
	# Понадобится — пробрасывается по SSH: ssh -L 9001:localhost:9001
	handle /minio/ui/* {
		respond 404
	}

	reverse_proxy minio:9000
}

# ПРИМЕЧАНИЕ про многопоточный рендеринг Flutter Web.
#
# Skwasm использует несколько потоков только при cross-origin isolation,
# а она требует заголовков Cross-Origin-Opener-Policy: same-origin и
# Cross-Origin-Embedder-Policy: require-corp.
#
# Мы их НЕ включаем осознанно: require-corp заблокирует загрузку сторонних
# ресурсов без заголовка CORP — в том числе аватарок пользователей с серверов
# Яндекса и вложений с домена хранилища. Без изоляции Skwasm работает
# в один поток, что для интерфейса трекера приемлемо.
