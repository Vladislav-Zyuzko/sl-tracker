# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Files that MUST keep LF (they run inside Linux containers).
*.sh          text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Caddyfile     text eol=lf

# Windows-only scripts keep CRLF.
*.bat         text eol=crlf
*.ps1         text eol=crlf

# Binary files: never touch.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
*.pdf         binary
*.woff        binary
*.woff2       binary
*.ttf         binary
