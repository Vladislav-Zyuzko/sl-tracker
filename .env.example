# Шаблон переменных окружения. Скопируй в .env и заполни:
#   cp .env.example .env
#
# .env в .gitignore и никогда не коммитится.
# Пароли ниже — заглушки, замени их. Сгенерировать хороший пароль:
#   openssl rand -base64 24

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=sl
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=sl_tracker
POSTGRES_PORT=5432

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# --- MinIO (S3-совместимое хранилище вложений) --------------------------------
MINIO_ROOT_USER=sl-minio
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=sl-attachments

# --- Локальный обратный прокси (профиль proxy) --------------------------------
DEV_PROXY_PORT=8081

# --- Яндекс ID (OAuth 2.0) ----------------------------------------------------
# Получить на https://oauth.yandex.ru — приложение типа «для авторизации пользователей»,
# права login:info, login:email, login:avatar.
# ВНИМАНИЕ: тип приложения выбирается один раз и не меняется.
# Приложение проходит модерацию; до одобрения возвращается unauthorized_client.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Callback должен совпадать с указанным при регистрации приложения, символ в символ.
YANDEX_REDIRECT_URI=http://localhost:8081/api/auth/yandex/callback

# --- Список доступа в трекер --------------------------------------------------
# Войти может только тот, чей email есть в списке доступа, либо тот, кто пришёл
# по действующему приглашению (приглашение работает в обход списка и пополняет его).
#
# Источник правды — таблица в БД. Эта переменная нужна для начального заполнения:
# без неё в пустом инстансе некому создать первый проект и некого пригласить.
# Применяется при старте API идемпотентно: перечисленные адреса добавляются,
# если их ещё нет; удаление из переменной НЕ удаляет запись из БД.
# Несколько адресов — через запятую.
ACCESS_LIST_BOOTSTRAP_EMAILS=

# --- Приложение ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# Секрет для подписи сессий. Обязательно свой, длинный, случайный.
SESSION_SECRET=change-me-session-secret
# Базовый адрес приложения — на него бэкенд редиректит после входа.
APP_BASE_URL=http://localhost:8081

# --- Прод (используется только в infra/compose/docker-compose.prod.yml) -------
SL_DOMAIN=tracker.example.com
SL_ACME_EMAIL=admin@example.com
